# ============================================
# CRYPTO INTELLIGENCE PLATFORM - ENV CONFIG
# ============================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://crypto:crypto@localhost:5432/crypto_intelligence
DATABASE_SYNC_URL=postgresql://crypto:crypto@localhost:5432/crypto_intelligence

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Mode ---
DEMO_MODE=true
LOG_LEVEL=INFO

# --- API Keys (all optional - system works without them) ---
COINGECKO_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
CRYPTOPANIC_API_KEY=
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
OPENAI_API_KEY=

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# --- Worker ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
